{
  "openapi": "3.0.2",
  "info": {
    "title": "ToDo List API",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://localhost:8080/api"
    }
  ],
  "paths": {
    "/tasks": {
      "post": {
        "summary": "Add a new task",
        "description": "Creates a new task with the provided details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taskName": {
                    "type": "string",
                    "description": "Name of the task."
                  },
                  "dueDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Due date for the task."
                  },
                  "description": {
                    "type": "string",
                    "description": "Additional details about the task."
                  }
                },
                "required": ["taskName", "dueDate"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task added successfully. Returns the created task.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQuery"
                }
              }
            }
          },
          "400": {
            "description": "Task cannot be created due to invalid input."
          }
        }
      },
      "get": {
        "summary": "Get all tasks",
        "description": "Retrieves all tasks in the system.",
        "operationId": "getAllTasks",
        "responses": {
          "200": {
            "description": "A list of tasks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskQuery"
                  },
                  "description": "Array of TaskQuery objects representing all tasks."
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "summary": "Get a task by ID",
        "description": "Retrieves a single task by its unique identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the task."
          }
        ],
        "responses": {
          "200": {
            "description": "Task retrieved successfully. Returns the task details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQuery"
                }
              }
            }
          },
          "404": {
            "description": "Task not found for the given ID."
          }
        }
      },
      "put": {
        "summary": "Edit a task",
        "description": "Updates the details of an existing task by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the task to update."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "taskName": {
                    "type": "string",
                    "description": "Updated name of the task."
                  },
                  "dueDate": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Updated due date for the task."
                  },
                  "status": {
                    "type": "string",
                    "enum": ["CREATED", "IN_PROGRESS", "DONE"],
                    "description": "Updated status of the task."
                  },
                  "description": {
                    "type": "string",
                    "description": "Updated description of the task."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task edited successfully. Returns the updated task.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskQuery"
                }
              }
            }
          },
          "404": {
            "description": "Task not found for the given ID."
          }
        }
      },
      "delete": {
        "summary": "Remove a task",
        "description": "Deletes a task by its unique identifier.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the task to delete."
          }
        ],
        "responses": {
          "204": {
            "description": "Task removed successfully. No content returned."
          },
          "404": {
            "description": "Task not found for the given ID."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskQuery": {
        "type": "object",
        "description": "Represents a task with its details.",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier of the task."
          },
          "taskName": {
            "type": "string",
            "description": "Name of the task."
          },
          "dueDate": {
            "type": "string",
            "format": "date-time",
            "description": "Due date for the task."
          },
          "status": {
            "type": "string",
            "enum": ["CREATED", "IN_PROGRESS", "DONE"],
            "description": "Current status of the task."
          },
          "description": {
            "type": "string",
            "description": "Additional details about the task."
          }
        }
      }
    }
  }
}