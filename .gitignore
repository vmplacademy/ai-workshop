# Global .gitignore for ai-workshop repository

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Icon must end with two \r
Icon

# Trashes
.Trashes

# macOS metadata
.Spotlight-V100
.fseventsd

# Windows system files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux system files
*~
.nfs*

# Editor swap/backup files
*.swp
*.swo
*.bak
*.tmp
*.temp

# VS Code global
.vscode/
!.vscode/mcp.json

# JetBrains IDEs global
.idea/
*.iml
*.ipr
*.iws

# Node.js global
node_modules/

# Python global
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Logs
*.log

# Coverage
coverage/
*.lcov

# Test output
/test-output/

# Claude
# Heads-up: a machine-wide rule (core.excludesFile, usually ~/.config/git/ignore)
# may hide these too, so editing this file alone can look like it did nothing.
# `git check-ignore -v <path>` reports which rule actually wins.
.claude/worktrees/
.claude/settings.local.json

# By convention, framework-specific .gitignore files are in subfolders
